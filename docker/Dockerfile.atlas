# Atlas overlay on the NeMo-RL training image: everything the agentic
# CudaGym path needs INSIDE the training container, where the NeMo-Gym servers
# and the OpenCode subprocesses run (the GRPO driver spins Gym up on the driver
# node with NodeAffinity + inherited os.environ — there is no separate agent
# container).
#
# Build (from the nemo-rl repo root, after building/pulling the base image):
#   docker build -f docker/Dockerfile.atlas --build-arg BASE_IMAGE=<nemo-rl image> -t nemo-rl-atlas .
#   # then squash for pyxis/enroot:  enroot import -o nemorl-atlas.sqsh dockerd://nemo-rl-atlas
#   # and point slurm/clusters/<cluster>.yaml paths.container at the .sqsh.
#
# Eval-side CudaGym servers use a SEPARATE image (cluster yaml
# paths.cudagym_container), built from the cudagym repo's docker/<profile>.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Node 22 (matches responses_api_agents/opencode_agent/setup_opencode.py) + a
# pinned opencode (matches cudagym_cuda_agent.yaml opencode_version).
ARG NODE_VERSION=22.15.0
ARG OPENCODE_VERSION=1.17.9
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/').tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
 && npm install -g "opencode-ai@${OPENCODE_VERSION}" \
 && opencode --version

# CudaGym SDK + CLI available system-wide (the Gym server venvs also install it
# editable from 3rdparty/cudagym via their requirements.txt; this system copy is
# what the agent SANDBOX's PATH sees for `cudagym` / `kf`).
COPY 3rdparty/cudagym /opt/cudagym
# The copied tree has no .git (submodule .git is a pointer outside the build
# context), so setuptools-scm can't derive cudagym's version — pin it by hand.
# Keep the pin in sync with the submodule's tag when bumping 3rdparty/cudagym
# (check with: git -C 3rdparty/cudagym describe --tags).
RUN SETUPTOOLS_SCM_PRETEND_VERSION_FOR_CUDAGYM=2.3.2 \
    pip install --no-cache-dir -e /opt/cudagym
